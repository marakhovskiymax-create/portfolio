/* tastemaker · macrostructure: Editorial Index · mood: elegant · page: landing
 * arc: hook(H1) -> proof/work(F6) -> capability -> how(F4) -> proof(P2) -> person -> close(C2)
 * nav: N4 · hero: H1 · footer: Ft2 · knobs: hero=statement/centered/stars; work=editorial-index/case-panel
 * palette: Figma reference (elegant/dark) · contrast: pass (matrix)
 * critique: ShowTell 4 · Phil 5 · Hier 5 · Spec 5 · Restr 5 · Var 5 */

:root {
  color-scheme: dark;
  --color-bg: #050505;
  --color-surface: #0b0d0b;
  --color-primary: #f4f3ee;
  --color-accent: #72c98b;
  --color-text: #f4f3ee;
  --color-muted: #b9b8b2;
  --color-border: #3b3d39;
  --color-ink: #050505;
  --font-display: "Playfair Display", Georgia, serif;
  --font-body: "Nunito Sans", Arial, sans-serif;
  --radius-small: 999px;
  --radius-medium: 20px;
  --radius-large: 32px;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-6: 24px;
  --space-8: 32px;
  --space-12: 48px;
  --space-16: 64px;
  --space-24: 96px;
  --space-32: 128px;
  --space-40: 160px;
  --space-48: 192px;
  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  --curve-cinematic: cubic-bezier(0.77, 0, 0.175, 1);
  --motion-fast: 80ms;
  --motion-fast-exit: 60ms;
  --motion-moderate: 160ms;
  --motion-moderate-exit: 120ms;
  --motion-slow: 240ms;
  --motion-slow-exit: 160ms;
  --duration-press: var(--motion-fast);
  --duration-panel: var(--motion-slow);
  --shell: min(1180px, calc(100vw - 64px));
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 88px;
  overflow-x: clip;
  background: var(--color-bg);
}

body {
  min-width: 320px;
  margin: 0;
  overflow-x: clip;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: rgba(114, 201, 139, 0.24);
}

button,
a {
  touch-action: manipulation;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

h1,
h2,
h3,
p,
figure,
blockquote {
  margin: 0;
}

h1,
h2,
h3 {
  text-wrap: balance;
}

section[id] {
  scroll-margin-top: 88px;
}

.shell {
  width: var(--shell);
  margin-inline: auto;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: fixed;
  z-index: 100;
  inset: 12px auto auto 12px;
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-small);
  background: var(--color-primary);
  color: var(--color-ink);
  transform: translateY(-160%);
}

.skip-link:focus {
  transform: translateY(0);
}

:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 4px;
}

.site-header {
  position: absolute;
  z-index: 20;
  inset: 0 0 auto;
}

.masthead {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  min-height: 88px;
  font-size: 0.8125rem;
}

.masthead__links {
  display: flex;
  align-items: center;
  gap: var(--space-6);
}

.masthead__links--meta {
  justify-content: flex-end;
}

.masthead a,
.footer a {
  color: var(--color-muted);
  transition: color var(--duration-press) var(--ease-out);
  white-space: nowrap;
}

.masthead a:hover,
.footer a:hover {
  color: var(--color-text);
}

.wordmark {
  color: var(--color-text) !important;
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.035em;
}

.menu-toggle,
.mobile-menu {
  display: none;
}

.hero {
  position: relative;
  isolation: isolate;
  display: grid;
  min-height: 780px;
  place-items: center;
  overflow: clip;
}

.hero::after {
  position: absolute;
  z-index: -1;
  inset: 0;
  content: "";
  background:
    radial-gradient(circle at 50% 42%, transparent 0 18%, rgba(5, 5, 5, 0.3) 45%, var(--color-bg) 79%),
    linear-gradient(to bottom, transparent 70%, var(--color-bg) 100%);
}

.hero__stars {
  position: absolute;
  z-index: -3;
  inset: 0;
  opacity: 0.72;
  background-image:
    radial-gradient(circle, rgba(255, 255, 255, 0.82) 0 1px, transparent 1.5px),
    radial-gradient(circle, rgba(114, 201, 139, 0.68) 0 1px, transparent 1.4px),
    radial-gradient(circle, rgba(255, 255, 255, 0.42) 0 1.25px, transparent 1.6px);
  background-position: 7px 11px, 38px 29px, 91px 67px;
  background-size: 83px 79px, 137px 149px, 211px 197px;
  mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 86%, transparent);
}

.spider-cursor {
  position: fixed;
  z-index: 90;
  inset: 0;
  display: block;
  width: 100dvw;
  height: 100dvh;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--motion-slow) var(--ease-out);
}

body.has-spider-cursor .spider-cursor {
  opacity: 1;
}

@media (hover: hover) and (pointer: fine) {
  body.has-spider-cursor,
  body.has-spider-cursor a,
  body.has-spider-cursor button,
  body.has-spider-cursor [role="button"] {
    cursor: none;
  }
}

.hero__content {
  position: relative;
  display: grid;
  justify-items: center;
  padding-block: 140px var(--space-24);
  text-align: center;
}

.hero__intro {
  margin-bottom: var(--space-4);
  color: var(--color-muted);
  font-size: 0.8125rem;
}

.hero h1 {
  max-width: 1160px;
  min-width: 0;
  color: var(--color-text);
  font-family: var(--font-display);
  font-size: clamp(3.15rem, 5.25vw, 4.9rem);
  font-style: italic;
  font-weight: 600;
  letter-spacing: -0.045em;
  line-height: 1.02;
  overflow-wrap: anywhere;
}

.hero__lede {
  max-width: 520px;
  margin-top: var(--space-6);
  color: var(--color-muted);
  font-size: 1rem;
}

.button {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-6);
  border-radius: var(--radius-small);
  font-size: 0.9375rem;
  font-weight: 600;
  white-space: nowrap;
  transition:
    color var(--duration-press) var(--ease-out),
    background-color var(--duration-press) var(--ease-out),
    transform var(--duration-press) var(--ease-out);
}

.button--light {
  margin-top: var(--space-6);
  background: var(--color-primary);
  color: var(--color-ink);
}

.button:active,
.project-row:active,
.contact__link:active {
  transform: scale(0.97);
}

.hero__index {
  position: absolute;
  inset: auto auto var(--space-16) 0;
  color: var(--color-muted);
  font-size: 0.75rem;
}

.section {
  padding-block: var(--space-32);
  border-top: 1px solid var(--color-border);
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-8);
  margin-bottom: var(--space-16);
}

.section-heading h2 {
  color: var(--color-text);
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.25vw, 3.75rem);
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.035em;
  line-height: 1.12;
}

.section-heading p {
  max-width: 360px;
  color: var(--color-muted);
  font-size: 0.875rem;
  text-align: right;
}

.portfolio-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  gap: var(--space-8);
  align-items: stretch;
}

.project-list {
  position: relative;
  isolation: isolate;
  border-top: 1px solid var(--color-border);
}

.project-hover-highlight {
  position: absolute;
  z-index: -1;
  inset: 0 0 auto;
  height: var(--fluid-row-height, 84px);
  border: 1px solid rgba(114, 201, 139, 0.18);
  background: rgba(114, 201, 139, 0.07);
  opacity: 0;
  pointer-events: none;
  transform: translate3d(0, var(--fluid-highlight-y, 0), 0);
  transition:
    transform var(--motion-fast) var(--ease-out),
    opacity var(--motion-fast-exit) linear;
  will-change: transform, opacity;
}

.project-hover-highlight.is-visible {
  opacity: 1;
}

.project-row {
  display: grid;
  width: 100%;
  min-height: 84px;
  grid-template-columns: minmax(110px, 0.72fr) minmax(0, 1.4fr) auto;
  gap: var(--space-6);
  align-items: center;
  padding: 0;
  border: 0;
  border-bottom: 1px solid var(--color-border);
  background: transparent;
  color: var(--color-muted);
  cursor: pointer;
  text-align: left;
  transition:
    color var(--duration-press) var(--ease-out),
    transform var(--duration-press) var(--ease-out);
}

.project-row__name {
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.project-row__desc {
  min-width: 0;
  overflow-wrap: anywhere;
}

.project-row__arrow {
  font-size: 1.1rem;
  transform: translateX(0);
  transition: transform var(--duration-press) var(--ease-out);
}

.project-row:hover,
.project-row.is-active {
  color: var(--color-accent);
}

.project-row:hover .project-row__arrow,
.project-row.is-active .project-row__arrow {
  transform: translate(4px, -4px);
}

.case-visual {
  position: relative;
  isolation: isolate;
  min-height: 336px;
  overflow: hidden;
  border-radius: var(--radius-medium);
  background: var(--color-accent);
  color: var(--color-ink);
}

.case-visual::before {
  position: absolute;
  inset: 0;
  content: "";
  background-image:
    linear-gradient(rgba(5, 5, 5, 0.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(5, 5, 5, 0.12) 1px, transparent 1px);
  background-size: 88px 64px;
}

.case-visual__glow {
  position: absolute;
  inset: -25%;
  background:
    radial-gradient(circle at 18% 27%, rgba(244, 243, 238, 0.85), transparent 20%),
    radial-gradient(circle at 76% 18%, rgba(12, 74, 31, 0.78), transparent 34%),
    radial-gradient(circle at 65% 82%, rgba(213, 243, 220, 0.72), transparent 25%),
    var(--color-accent);
  filter: blur(28px);
  transform: scale(1.12);
  transition: transform var(--motion-slow) var(--curve-cinematic);
}

.case-visual__panel {
  position: absolute;
  z-index: 1;
  inset: 14% 9%;
  display: grid;
  grid-template-rows: auto 1fr auto;
  padding: var(--space-6);
  border: 1px solid rgba(5, 5, 5, 0.34);
  border-radius: var(--radius-medium);
  background: rgba(244, 243, 238, 0.16);
  backdrop-filter: blur(18px);
}

.case-visual__topline,
.case-visual__meta {
  display: flex;
  justify-content: space-between;
  gap: var(--space-4);
  font-size: 0.75rem;
}

.case-visual__title {
  align-self: center;
  max-width: 290px;
  font-size: clamp(1.8rem, 3vw, 3rem);
  font-weight: 600;
  letter-spacing: -0.05em;
  line-height: 0.98;
}

.capability-tape {
  width: 100%;
  overflow: hidden;
  border-block: 1px solid var(--color-border);
  padding-block: var(--space-4);
  color: var(--color-muted);
}

.capability-tape__track {
  display: flex;
  width: max-content;
  gap: var(--space-8);
  animation: tape 32s linear infinite;
  font-size: 0.8125rem;
  white-space: nowrap;
}

.capability-tape__track span::after {
  margin-left: var(--space-8);
  color: var(--color-accent);
  content: "·";
}

@keyframes tape {
  to {
    transform: translateX(-50%);
  }
}

.career-story {
  position: relative;
  min-height: 200svh;
  border-top: 1px solid var(--color-border);
  scroll-margin-top: 0;
}

.career-stage {
  position: sticky;
  top: 0;
  min-height: 680px;
  height: 100svh;
  padding-block: clamp(56px, 8vh, 96px);
  overflow: hidden;
}

.career-stage__heading h2 {
  color: var(--color-text);
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.25vw, 3.75rem);
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.035em;
  line-height: 1.12;
}

.career-track {
  position: relative;
  width: min(1480px, calc(100vw - 24px));
  height: 430px;
  margin: clamp(20px, 4vh, 40px) auto 0;
}

.career-route {
  position: absolute;
  z-index: 0;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  pointer-events: none;
}

.career-route--mobile {
  display: none;
}

.career-route__base,
.career-route__trace {
  fill: none;
  stroke-linecap: round;
  vector-effect: non-scaling-stroke;
}

.career-route__base {
  stroke: rgba(244, 243, 238, 0.28);
  stroke-dasharray: 1.4 4.8;
  stroke-width: 1.3;
}

.career-route__trace {
  stroke: rgba(244, 243, 238, 0.9);
  stroke-dasharray: 1.4 4.8;
  stroke-width: 1.5;
}

.career-route__draw {
  fill: none;
  stroke: #ffffff;
  stroke-dasharray: 1;
  stroke-dashoffset: 0;
  stroke-linecap: round;
  stroke-width: 8;
  vector-effect: non-scaling-stroke;
}

.career-journey {
  position: absolute;
  z-index: 1;
  inset: 0;
  margin: 0;
  padding: 0;
  list-style: none;
}

.career-stop {
  position: absolute;
  width: clamp(154px, 15vw, 222px);
}

.career-stop--hse {
  inset: 97px auto auto 4.2%;
}

.career-stop--match {
  inset: 98px auto auto 25.8%;
}

.career-stop--geleos {
  inset: 206px auto auto 46.8%;
}

.career-stop--don {
  inset: 99px auto auto 63.8%;
}

.career-stop--eme {
  inset: 91px auto auto 84%;
}

.career-logo {
  position: relative;
  display: block;
  object-fit: contain;
  object-position: left center;
}

.career-logo--hse {
  width: 36px;
  height: 36px;
}

.career-logo--match {
  width: 96px;
  height: 38px;
}

.career-logo--geleos {
  width: 44px;
  height: 44px;
  margin-left: -3px;
}

.career-logo--don {
  width: 172px;
  height: 34px;
}

.career-logo--eme {
  width: 66px;
  height: 32px;
}

.career-stop__body {
  margin-top: var(--space-2);
}

.career-stop h3 {
  font-size: 1.06rem;
  font-weight: 700;
  line-height: 1.25;
}

.career-stop p,
.career-stop time {
  display: block;
  color: var(--color-muted);
  font-size: clamp(0.72rem, 0.82vw, 0.82rem);
  line-height: 1.45;
}

.career-stop p {
  margin-top: var(--space-2);
}

.career-stop time {
  margin-top: var(--space-2);
  white-space: nowrap;
}

.section--process {
  position: relative;
  min-height: 170svh;
  border-bottom: 1px solid var(--color-border);
  scroll-margin-top: 0;
}

.process-stage {
  position: sticky;
  top: 0;
  display: flex;
  min-height: 620px;
  height: 100svh;
  flex-direction: column;
  justify-content: center;
  padding-block: clamp(56px, 8vh, 96px);
}

.section-heading--wide {
  margin-bottom: clamp(44px, 7vh, 76px);
}

.section-heading--wide h2 {
  font-family: var(--font-display);
  font-size: clamp(1.65rem, 2.1vw, 2.55rem);
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.03em;
  line-height: 1.12;
}

.process-line {
  position: relative;
  display: grid;
  min-height: clamp(300px, 40vh, 370px);
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: end;
  gap: var(--space-6);
  margin: 0;
  padding: 0;
  list-style: none;
}

.process-baseline {
  position: absolute;
  z-index: 0;
  inset: auto 0 0;
  height: 1px;
  background-image: repeating-linear-gradient(
    90deg,
    rgba(244, 243, 238, 0.56) 0 1px,
    transparent 1px 4px
  );
  transform-origin: left center;
}

.process-step {
  position: relative;
  z-index: 1;
  padding-left: 22px;
}

.process-step__stem {
  position: absolute;
  inset: calc(100% + 8px) auto auto var(--stem-x, 48px);
  width: 1px;
  height: var(--stem, 112px);
  background-image: repeating-linear-gradient(
    to bottom,
    rgba(244, 243, 238, 0.54) 0 1px,
    transparent 1px 4px
  );
  transform-origin: bottom center;
}

.process-step--one {
  margin-bottom: 123px;
  --stem: 115px;
  --stem-x: 48px;
}

.process-step--two {
  margin-bottom: 72px;
  --stem: 64px;
  --stem-x: 56px;
}

.process-step--three {
  margin-bottom: 182px;
  --stem: 174px;
  --stem-x: 48px;
}

.process-step--four {
  margin-bottom: 34px;
  --stem: 26px;
  --stem-x: 52px;
}

.process-step__number {
  position: absolute;
  inset: 2px auto auto 0;
  color: var(--color-muted);
  font-size: 0.7rem;
}

.process-step h3 {
  font-size: clamp(1.1rem, 1.38vw, 1.45rem);
  font-weight: 700;
  line-height: 1.16;
}

.process-step p {
  margin-top: 5px;
  color: var(--color-muted);
  font-size: clamp(0.66rem, 0.76vw, 0.8rem);
  line-height: 1.4;
}

.quote-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-8);
}

.quote-card {
  min-height: 310px;
  padding: var(--space-8);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-medium);
  cursor: none;
}

.quote-card--offset {
  margin-top: var(--space-16);
}

.quote-card blockquote {
  font-family: var(--font-display);
  font-size: clamp(1.65rem, 2.8vw, 2.75rem);
  font-style: italic;
  line-height: 1.16;
}

.quote-card figcaption {
  margin-top: var(--space-8);
  color: var(--color-muted);
  font-size: 0.75rem;
}

.section--about {
  width: min(90vw, 2300px);
  min-height: 720px;
  padding-block: clamp(40px, 5vw, 72px) var(--space-16);
  border-bottom: 1px dotted rgba(244, 243, 238, 0.42);
}

.section--about .section-heading {
  margin-bottom: clamp(30px, 4vw, 52px);
}

.about-map {
  position: relative;
  min-height: 470px;
}

.about-note {
  position: absolute;
  z-index: 1;
  min-width: 0;
}

.about-note p {
  color: var(--color-muted);
  font-size: clamp(0.92rem, 1.18vw, 1.13rem);
  line-height: 1.36;
}

.about-note strong {
  color: var(--color-text);
  font-size: 1.42em;
  font-weight: 500;
  letter-spacing: -0.025em;
  text-transform: uppercase;
}

.about-note--fashion {
  inset: 0 auto auto 0;
  width: min(39%, 470px);
}

.about-note--film {
  inset: 150px auto auto 35%;
  width: min(31%, 380px);
  text-align: right;
}

.about-note--games {
  inset: 0 0 auto auto;
  width: min(20%, 380px);
}

.about-badges {
  position: absolute;
  z-index: 2;
  inset: 0;
  pointer-events: none;
}

.about-badge {
  position: absolute;
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  justify-content: center;
  padding: 0 18px;
  border-radius: var(--radius-small);
  background: var(--color-primary);
  color: var(--color-ink);
  font-size: clamp(0.78rem, 1vw, 0.95rem);
  font-weight: 600;
  line-height: 1;
  pointer-events: auto;
  white-space: nowrap;
}

.about-badge--vibe {
  inset: 158px auto auto 1.5%;
  transform: rotate(-1.5deg);
}

.about-badge--cinema {
  inset: 286px auto auto 16.5%;
  transform: rotate(-4deg);
}

.about-badge--shooting {
  inset: 148px auto auto 25.5%;
  transform: rotate(-1.5deg);
}

.about-badge--games {
  inset: -14px auto auto 48%;
  transform: rotate(1deg);
}

.about-badge--science {
  inset: 141px auto auto 67%;
  transform: rotate(2.5deg);
}

.about-badge--music {
  inset: 248px 0 auto auto;
  transform: rotate(6deg);
}

.about-badge--fashion {
  inset: 336px 22% auto auto;
  transform: rotate(-1deg);
}

.contact {
  padding-block: var(--space-48) var(--space-40);
  border-top: 1px solid var(--color-border);
}

.contact__kicker {
  color: var(--color-accent);
  font-size: 0.8125rem;
  text-transform: uppercase;
}

.contact h2 {
  max-width: 920px;
  margin-top: var(--space-6);
  font-family: var(--font-display);
  font-size: clamp(3rem, 6vw, 6.5rem);
  font-style: italic;
  font-weight: 500;
  letter-spacing: -0.045em;
  line-height: 1.02;
}

.contact__link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  min-height: 52px;
  margin-top: var(--space-12);
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--color-accent);
  color: var(--color-accent);
  font-size: 1.15rem;
  transition:
    color var(--duration-press) var(--ease-out),
    transform var(--duration-press) var(--ease-out);
}

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  padding-block: var(--space-8);
  border-top: 1px solid var(--color-border);
  color: var(--color-muted);
  font-size: 0.75rem;
}

@media (hover: hover) and (pointer: fine) {
  .button:hover {
    transform: translateY(-2px);
  }

  .case-visual:hover .case-visual__glow {
    transform: scale(1.18) translate(1.5%, -1.5%);
  }

  .contact__link:hover {
    color: var(--color-text);
    transform: translateX(4px);
  }
}

@media (max-width: 900px) {
  :root {
    --shell: min(100% - 40px, 720px);
  }

  .masthead {
    grid-template-columns: auto 1fr auto;
  }

  .masthead__links {
    display: none;
  }

  .wordmark {
    grid-column: 1;
  }

  .menu-toggle {
    display: inline-flex;
    grid-column: 3;
    min-width: 72px;
    min-height: 44px;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .menu-toggle__line {
    width: 18px;
    height: 1px;
    background: currentColor;
    box-shadow: 0 5px currentColor;
  }

  .mobile-menu {
    position: absolute;
    inset: 72px 20px auto;
    display: grid;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu a {
    display: flex;
    min-height: 48px;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu a:last-child {
    border-bottom: 0;
  }

  .hero {
    min-height: 760px;
  }

  .hero h1 {
    font-size: clamp(3rem, 8vw, 4.75rem);
  }

  .portfolio-grid,
  .quote-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .case-visual {
    min-height: 390px;
  }

  .career-story {
    min-height: 0;
    padding-block: var(--space-24);
  }

  .career-stage {
    position: relative;
    top: auto;
    height: auto;
    min-height: 0;
    padding-block: 0;
    overflow: visible;
  }

  .career-track {
    width: var(--shell);
    height: 1080px;
    margin-top: var(--space-12);
  }

  .career-route--desktop {
    display: none;
  }

  .career-route--mobile {
    display: block;
  }

  .career-stop {
    width: min(240px, calc(100% - 60px));
  }

  .career-stop--hse {
    inset: 33px auto auto 10%;
  }

  .career-stop--match {
    inset: 228px auto auto 26%;
  }

  .career-stop--geleos {
    inset: 437px auto auto 9%;
  }

  .career-stop--don {
    inset: 653px auto auto 22%;
  }

  .career-stop--eme {
    inset: 866px auto auto 12%;
  }

  .career-stop p,
  .career-stop time {
    font-size: 0.8125rem;
  }

  .section--process {
    min-height: 0;
    padding-block: var(--space-24);
  }

  .process-stage {
    position: relative;
    top: auto;
    height: auto;
    min-height: 0;
    padding-block: 0;
  }

  .section-heading--wide {
    margin-bottom: var(--space-12);
  }

  .process-line {
    min-height: 360px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16) var(--space-8);
  }

  .process-baseline,
  .process-step__stem {
    display: none;
  }

  .process-step,
  .process-step--one,
  .process-step--two,
  .process-step--three,
  .process-step--four {
    margin-bottom: 0;
    padding: 0 0 0 var(--space-6);
  }

  .process-step__number {
    inset-inline-start: 0;
  }

  .quote-card--offset {
    margin-top: 0;
  }

  .section--about {
    min-height: 0;
  }

  .about-map {
    display: grid;
    min-height: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-16) var(--space-8);
  }

  .about-note,
  .about-note--fashion,
  .about-note--film,
  .about-note--games {
    position: static;
    width: auto;
    text-align: left;
  }

  .about-note--games {
    grid-column: 2;
  }

  .about-badges {
    position: relative;
    inset: auto;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, max-content);
    justify-content: space-between;
    gap: var(--space-4);
  }

  .about-badge,
  .about-badge--vibe,
  .about-badge--cinema,
  .about-badge--shooting,
  .about-badge--games,
  .about-badge--science,
  .about-badge--music,
  .about-badge--fashion {
    position: static;
    transform: none;
  }
}

@media (max-width: 640px) {
  :root {
    --shell: calc(100% - 32px);
  }

  .hero {
    min-height: 720px;
  }

  .hero__content {
    justify-items: start;
    padding-block: var(--space-32) var(--space-16);
    text-align: left;
  }

  .hero__intro {
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: clamp(2.8rem, 14vw, 4.15rem);
    letter-spacing: -0.05em;
    line-height: 1.03;
  }

  .hero__lede {
    max-width: 320px;
  }

  .hero__index {
    inset-inline-start: auto;
    inset-inline-end: 0;
  }

  .section {
    padding-block: var(--space-24);
  }

  .section-heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .section-heading p {
    text-align: left;
  }

  .project-row {
    grid-template-columns: minmax(90px, 0.6fr) minmax(0, 1.2fr) auto;
    gap: var(--space-3);
    min-height: 76px;
  }

  .project-row__name,
  .project-row__desc {
    font-size: 0.75rem;
  }

  .case-visual {
    min-height: 320px;
  }

  .case-visual__panel {
    inset: 11% 7%;
  }

  .career-story {
    padding-block: var(--space-24);
  }

  .process-line {
    grid-template-columns: minmax(0, 1fr);
    min-height: 0;
  }

  .process-step,
  .process-step--one,
  .process-step--two,
  .process-step--three,
  .process-step--four {
    padding: var(--space-6) 0 var(--space-6) var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .process-step__number {
    inset: calc(var(--space-6) + 3px) auto auto 0;
  }

  .quote-card {
    min-height: 250px;
    padding: var(--space-6);
  }

  .about-map {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
  }

  .about-note--fashion,
  .about-note--film,
  .about-note--games {
    grid-column: 1;
  }

  .about-note p {
    font-size: 0.95rem;
  }

  .about-badges {
    grid-column: 1;
    grid-template-columns: repeat(2, max-content);
    justify-content: start;
    gap: var(--space-3);
  }

  .about-badge {
    min-height: 38px;
    padding-inline: var(--space-4);
    font-size: 0.78rem;
  }

  .contact {
    padding-block: var(--space-32);
  }

  .contact h2 {
    font-size: clamp(2.8rem, 13vw, 4.1rem);
  }

  .footer {
    align-items: flex-start;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
  }

  .capability-tape__track {
    animation-play-state: paused;
  }

  .spider-cursor {
    display: none;
  }

  .career-stop {
    opacity: 1 !important;
    transform: none !important;
  }

  .career-route__draw {
    stroke-dashoffset: 0 !important;
  }

  .process-baseline,
  .process-step__stem,
  .process-step {
    opacity: 1 !important;
    transform: none !important;
  }

  .case-visual__glow,
  .button,
  .project-row,
  .project-row__arrow,
  .contact__link {
    transition-duration: var(--motion-fast);
  }

  .project-hover-highlight {
    transition:
      transform 0ms,
      opacity var(--motion-fast) linear;
  }
}

@media (prefers-contrast: more) {
  :root {
    --color-border: #8b8b85;
  }

  .case-visual__panel {
    background: rgba(244, 243, 238, 0.5);
    backdrop-filter: none;
  }
}

@media (prefers-reduced-transparency: reduce) {
  .case-visual__panel {
    background: rgba(244, 243, 238, 0.74);
    backdrop-filter: none;
  }
}
